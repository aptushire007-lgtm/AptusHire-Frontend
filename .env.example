# Backend API base — origin + "/api" path, NO trailing slash.
# Vite inlines this at BUILD time, so changing it in Vercel requires a redeploy.
#
#   local dev : http://localhost:9000/api   (or "/api" to use the Vite proxy)
#   production: https://aptushire-backend-production.up.railway.app/api
VITE_API_URL=http://localhost:9000/api

# Google Identity Services web client ID. Use the same value as backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
